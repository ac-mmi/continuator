# Memory extractor (optional overrides)

# Backend: mlx (Apple Silicon), transformers (CPU/GPU), or mock (smoke tests)
# MEMORY_EXTRACTOR_BACKEND=mlx

# Memory model: v10 (default) or v9
# MEMORY_MODEL=v10

# Hugging Face repo for the LoRA adapter (default: continuator-ai/continuator-v10-lora)
# MEMORY_EXTRACTOR_HF_REPO=continuator-ai/continuator-v10-lora

# Local adapter directory (skips Hugging Face download)
# MEMORY_EXTRACTOR_ADAPTER_PATH=~/.cache/continuator/models/v10

# Model download cache root
# CONTINUATOR_MODEL_CACHE=~/.cache/continuator/models

# Hugging Face token (only for private/gated repos)
# HF_TOKEN=

# Extraction profile
# MEMORY_EXTRACTOR_PROFILE=fast
# MEMORY_EXTRACTOR_MAX_NEW_TOKENS=1536

# Engine path override (rare)
# CONTINUATOR_ENGINE_ROOT=/path/to/continuator_engine
