/* Continuator TUI — Conversation Intelligence layout */

Screen {
    background: #0d1117;
}

#status-bar {
    dock: top;
    height: 1;
    padding: 0 2;
    background: #0891b2;
    color: #ecfeff;
    text-style: bold;
}

#main-body {
    height: 1fr;
}

.hidden {
    display: none;
}

/* ── Workspace split ───────────────────────────────────────── */

#workspace-view {
    height: 1fr;
}

#workspace-split {
    height: 1fr;
}

#side-panel {
    width: 34;
    min-width: 28;
    height: 1fr;
    border-right: solid #1e3a4a;
    background: #0a1018;
}

#content-panel {
    width: 1fr;
    height: 1fr;
}

.panel-heading {
    dock: top;
    height: 1;
    padding: 0 1;
    background: #111827;
    color: #67e8f9;
    text-style: bold;
    border-bottom: solid #1e3a4a;
}

#analysis-panel {
    height: auto;
    max-height: 8;
    padding: 1 2;
    background: #111827;
    border-bottom: solid #1e3a4a;
}

#stage-label {
    color: #a5f3fc;
    margin-bottom: 1;
}

#rank-detail {
    color: #94a3b8;
    margin-top: 1;
}

ProgressBar {
    height: 1;
}

ProgressBar > .bar--bar {
    color: #22c55e;
    background: #1e293b;
}

ProgressBar > .bar--complete {
    color: #22c55e;
}

#briefing-scroll {
    height: 1fr;
    padding: 1 2;
    background: #0d1117;
    scrollbar-gutter: stable;
}

#briefing-content {
    width: 100%;
    height: auto;
}

#briefing-placeholder {
    color: #64748b;
    text-style: italic;
    padding: 1 0;
}

Footer {
    background: #0f1720;
    color: #64748b;
}

Footer > .footer--key {
    color: #22d3ee;
    text-style: bold;
}

Footer > .footer--description {
    color: #94a3b8;
}

#action-footer {
    dock: bottom;
    height: 3;
    padding: 0 2;
    background: #0f1720;
    border-top: solid #0891b2;
    align: center middle;
}

#export-group Button, #nav-group Button {
    margin: 0 1;
    min-width: 12;
}

#export-group Button {
    background: #1e293b;
    color: #e2e8f0;
}

#export-group Button:disabled {
    opacity: 0.4;
}

#nav-group Button.-primary {
    background: #0891b2;
    color: #ecfeff;
}

.footer-sep {
    color: #334155;
    margin: 0 2;
    width: auto;
}

/* ── Modals ────────────────────────────────────────────────── */

OpenFileScreen, SaveFileScreen {
    align: center middle;
}

#open-dialog, #save-dialog {
    width: 80;
    height: auto;
    max-height: 85%;
    padding: 1 2;
    background: #111827;
    border: solid #0891b2;
}

#open-hint {
    color: #94a3b8;
    margin-bottom: 1;
}

#open-dialog Input, #save-dialog Input {
    margin: 1 0;
}

#open-dialog Button, #save-dialog Button {
    margin-right: 1;
}

DirectoryTree {
    height: 18;
    margin: 1 0;
    border: solid #1e3a4a;
}

DirectoryTree:focus > .directory-tree--folder,
DirectoryTree:focus > .directory-tree--file {
    background: #164e63;
}
